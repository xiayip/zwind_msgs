# Read-only snapshot. Never configures, homes, clears faults or drives motors.
---
uint8[3] firmware_version
uint64 session
uint32 uptime_ms
uint8 controller_state
uint8 controller_fault
uint8 controller_ack
bool calibration_valid
bool position_valid
# 0 unknown, 1 confirmed closed, 2 bench homed, 3 confirmed open,
# 4 installed HOME with encoder out-and-back verification (not a limit input).
uint8 reference_source
float32 target_position
# B, C; NaN while position_valid is false.
float32[2] actuator_position
int64[2] encoder_count
bool stop_confirmed
# Bounded-memory health, for checking this small MCU after an upgrade.
uint32 heap_used_bytes
uint32 heap_peak_bytes
uint32 heap_failures
uint32 main_stack_free_bytes
# Stable across Agent reconnects, changes on MCU reset (first session epoch token).
uint64 boot_id
uint8 STARTUP_AVAILABLE=0
uint8 STARTUP_RUNNING=1
uint8 STARTUP_SUCCEEDED=2
uint8 STARTUP_FAILED=3
uint8 STARTUP_SUPPRESSED=4
# RAM-only, per MCU boot. Manual use also consumes startup eligibility.
uint8 startup_home_state
