# Finite Cartesian motion. All poses refer to the configured MPC TCP.
uint8 POSE=0
uint8 RELATIVE=1
uint8 PATH=2
# Opt-in continuous interpolation through waypoints; only whole-path ends stop.
# Does not imply collision checking, constant speed, or online path replacement.
uint8 CONTINUOUS_PATH=3
uint8 mode 0
geometry_msgs/PoseStamped target
# Translation in metres; rotation vector in radians, expressed in header.frame_id.
# Empty frame uses the MPC reference frame; the TCP frame uses measured TCP axes.
geometry_msgs/TwistStamped relative
geometry_msgs/PoseStamped[] waypoints
# Fraction of the configured reference velocity/acceleration/jerk limits (0, 1].
float64 speed_scale 1.0
float64 position_tolerance 0.005
float64 orientation_tolerance 0.03
float64 settle_time 0.2
# 0: reference duration + settle_time + max(5 s, 25% of reference duration).
# Positive: strict total wall-time deadline from acceptance, never auto-extended.
float64 timeout 0.0

# Optional whole-body extension: empty preserves TCP-only behavior.
# POSE: one item; CONTINUOUS_PATH: one per waypoint. PATH/RELATIVE unsupported.
# Same enabled components / posture names at every waypoint. Base frame must
# match the MPC fixed reference frame (normally odom). No moving-frame targets.
zephyr_msgs/WholeBodyReference[] whole_body_references
# Nonnegative soft costs; zero disables that component. Not hard constraints.
float64 base_position_weight 0.0
float64 base_yaw_weight 0.0
float64 posture_weight 0.0
# Final base arrival gates when the corresponding weight > 0, in m / rad.
# Posture is only a preference and does not gate success. TCP gates still apply.
float64 base_position_tolerance 0.02
float64 base_yaw_tolerance 0.03
---
bool success
# Uses ControllerMotionStatus reason constants. NONE means successful arrival.
uint16 reason
string message
geometry_msgs/PoseStamped actual
float64 position_error
float64 orientation_error
float64 base_position_error
float64 base_yaw_error
---
uint8 state
geometry_msgs/PoseStamped actual
geometry_msgs/PoseStamped target
float64 position_error
float64 orientation_error
float64 elapsed
float64 base_position_error
float64 base_yaw_error
