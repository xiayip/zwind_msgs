# Normalized actuator travel: 0 closed/retracted, 1 open/extended.
# This is not a door-angle ratio. MOVE never homes or assumes a zero.
uint8 MOVE=0
uint8 CONFIRM_CLOSED=1
uint8 CONFIRM_OPEN=2
uint8 CLEAR_FAULT=3
uint8 HOME=4
# Startup-only HOME, at most once per MCU boot; never clears faults.
uint8 STARTUP_HOME=5
# Firmware >= 0.11: HOME retracts, probes outward ~2 mm, then retracts again.
# It establishes a closed reference only after encoder repeatability checks.
# No independent limit input: a repeatable obstruction can resemble an endpoint.
# Maintenance operations do not drive motors. Endpoint confirmation is explicit.
uint8 operation
float32 position
# Required for STARTUP_HOME only: boot_id from a fresh GetHatchState response.
# Manual operations leave this zero. Reject a request crossing an MCU reset.
uint64 expected_boot_id
# STARTUP_HOME only: expires in MCU uptime units; at most 3 s into the future.
uint32 startup_deadline_uptime_ms
---
uint16 OK=0
uint16 INVALID_TARGET=1
uint16 BUSY=2
uint16 STATUS_STALE=3
uint16 UNREFERENCED=4
uint16 NOT_READY=5
uint16 CONTROLLER_FAULT=6
uint16 COMMAND_REJECTED=7
uint16 ACK_TIMEOUT=8
uint16 SESSION_CHANGED=9
uint16 MOTION_INTERRUPTED=10
uint16 TIMEOUT=11
uint16 CANCELED=12
uint16 STOPPED=13
uint16 INTERNAL_ERROR=14
# HOME success includes a valid zero with both outputs off (firmware >= 0.11).
bool success
uint16 error_code
string<=128 message
# Board controller diagnostics. No per-port fault attribution.
uint8 controller_fault
uint8 controller_ack
uint8 controller_state
bool position_valid
# B, C; NaN if no fresh valid reference.
float32[2] final_position
# True only when the controller confirms both motor outputs disabled.
bool stop_confirmed
---
float32 target_position
float32[2] actuator_position
bool position_valid
uint8 controller_state
uint8 controller_fault
float32 synchronization_error
float32 elapsed_sec
